DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

NIFTY500_DATA_SOURCE=csv
NIFTY500_UNIVERSE_PATH=data/universe/nifty500.csv

TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

DATABASE_PATH=storage/nifty500.db
MEMORY_PATH=storage/memory.json
RULES_PATH=storage/rules.json

PORTFOLIO_INITIAL_CAPITAL=1000000
PORTFOLIO_RISK_PER_TRADE=0.5
MAX_PORTFOLIO_RISK=5.0

EMA_FAST=20
EMA_MEDIUM=50
EMA_SLOW=200

RSI_PERIOD=14
ATR_PERIOD=14
VOLUME_MA_PERIOD=20

BREAKOUT_LOOKBACK=20
MIN_RELATIVE_VOLUME=1.5

MIN_RR=1.5
TARGET_RR=2.0

MAX_AI_CANDIDATES=15
AI_CONFIDENCE_THRESHOLD=65

MIN_AVG_VOLUME=100000
MIN_AVG_TRADED_VALUE=2500000

SIGNAL_EXPIRY_MINUTES=240

BROKERAGE_PCT=0.01
STT_PCT=0.01
SLIPPAGE_TICKS=2

LOG_LEVEL=INFO
